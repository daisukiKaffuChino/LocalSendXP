#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Icon / manifest

IDI_APP             ICON            "..\\icons\\icon.ico"
IDI_TOOL_FROM_URL   ICON            "..\\icons\\get_from_url.ico"
IDI_TOOL_OPEN_FOLDER ICON           "..\\icons\\get_folder.ico"
IDI_TOOL_SETTINGS   ICON            "..\\icons\\settings.ico"
IDI_TOOL_ABOUT      ICON            "..\\icons\\about.ico"
IDI_TOOL_HISTORY    ICON            "..\\icons\\history.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID  RT_MANIFEST  "LocalSendXP.manifest"

/////////////////////////////////////////////////////////////////////////////
// Menu

IDR_MAINMENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "发送文件(&S)...",                 IDM_FILE_SEND
        MENUITEM "发送文件夹(&D)...",               IDM_FILE_SENDFOLDER
        MENUITEM "通过浏览器分享(&B)...",            IDM_FILE_SHARE
        MENUITEM "从网址接收(&U)...",               IDM_FILE_FROMURL
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                        IDM_FILE_EXIT
    END
    POPUP "设备(&D)"
    BEGIN
        MENUITEM "刷新设备列表(&R)\tF5",            IDM_DEVICE_REFRESH
        MENUITEM "向选中设备发送(&S)",               IDM_DEVICE_SEND
        MENUITEM SEPARATOR
        MENUITEM "打开接收文件夹(&O)",               IDM_DEVICE_OPENFOLDER
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "设置(&O)...",                     IDM_TOOLS_SETTINGS
        MENUITEM "最小化到系统托盘(&M)",             IDM_TOOLS_TRAY
        MENUITEM SEPARATOR
        MENUITEM "开机时自动启动(&A)",               IDM_TOOLS_AUTOSTART
        MENUITEM "查看日志文件(&L)",                 IDM_TOOLS_LOG
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "使用说明(&R)\tF1",                 IDM_HELP_GUIDE
        MENUITEM "LocalSend 协议(&P)",               IDM_HELP_PROTOCOL
        MENUITEM SEPARATOR
        MENUITEM "关于 LocalSend XP(&A)...",         IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Accelerator

IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_F5,          IDM_DEVICE_REFRESH,     VIRTKEY
    VK_F1,          IDM_HELP_GUIDE,         VIRTKEY
    "S",            IDM_FILE_SEND,          VIRTKEY, CONTROL
    "U",            IDM_FILE_FROMURL,       VIRTKEY, CONTROL
    "O",            IDM_TOOLS_SETTINGS,     VIRTKEY, CONTROL
    "H",            IDM_TOOLS_HISTORY,      VIRTKEY, CONTROL
    VK_ESCAPE,      IDM_TOOLS_TRAY,         VIRTKEY
END

/////////////////////////////////////////////////////////////////////////////
// About

IDD_ABOUT DIALOGEX 0, 0, 340, 180
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 LocalSend XP"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    ICON            IDI_APP,IDC_STATIC,14,14,21,20
    LTEXT           "",IDC_ABOUT_NAME,60,13,266,10,SS_NOPREFIX
    LTEXT           "",IDC_ABOUT_SUBTITLE,60,26,266,10
    LTEXT           "",IDC_ABOUT_INFO,60,46,266,26,SS_NOPREFIX
    LTEXT           "",IDC_ABOUT_PROTOCOL,60,75,266,20
    LTEXT           "",IDC_ABOUT_CREDIT,60,96,266,26
    LTEXT           "作者：GitHub @daisukiKaffuChino",IDC_ABOUT_AUTHOR,60,124,266,10
    PUSHBUTTON      "开源仓库(&G)",IDC_ABOUT_SOURCE,208,159,62,14
    DEFPUSHBUTTON   "确定",IDOK,276,159,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Built-in help

IDD_HELP DIALOGEX 0, 0, 360, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "使用说明"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    EDITTEXT        IDC_HELP_TEXT,8,8,344,216,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "关闭",IDCANCEL,302,231,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Receive history

IDD_HISTORY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "历史记录"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "",IDC_HIST_SUMMARY,7,6,416,10
    CONTROL         "",IDC_HIST_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,20,416,182
    LTEXT           "",IDC_HIST_HINT,7,206,416,10,SS_ENDELLIPSIS
    DEFPUSHBUTTON   "打开所在文件夹(&O)",IDC_HIST_OPEN,146,229,84,14
    PUSHBUTTON      "删除记录(&D)",IDC_HIST_DELETE,235,229,64,14
    PUSHBUTTON      "清空历史(&L)",IDC_HIST_CLEAR,304,229,64,14
    PUSHBUTTON      "关闭",IDCANCEL,373,229,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Settings

IDD_SETTINGS DIALOGEX 0, 0, 346, 304
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    CONTROL         "",IDC_SET_TABS,"SysTabControl32",WS_TABSTOP,7,7,332,258
    LTEXT           "设置的改变会立即生效；端口与加密设置的修改需要重新启动程序。",IDC_SET_NOTE,7,270,332,20
    DEFPUSHBUTTON   "确定",IDOK,236,286,50,14
    PUSHBUTTON      "取消",IDCANCEL,289,286,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Settings pages

IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 318, 232
STYLE DS_SETFONT | WS_CHILD
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    GROUPBOX        "本机标识",IDC_GRP_DEVICE,7,7,304,96
    LTEXT           "设备名称：",IDC_LBL_ALIAS,16,24,110,10
    EDITTEXT        IDC_SET_ALIAS,132,22,120,13,ES_AUTOHSCROLL
    LTEXT           "本机类型：",IDC_LBL_TYPE,16,44,110,10
    COMBOBOX        IDC_SET_TYPE,132,42,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "设备型号：",IDC_LBL_MODEL,16,64,110,10
    EDITTEXT        IDC_SET_MODEL,132,62,120,13,ES_AUTOHSCROLL
    LTEXT           "界面语言：",IDC_LBL_LANGUAGE,16,84,110,10
    COMBOBOX        IDC_SET_LANGUAGE,132,82,120,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "启动与托盘",IDC_GRP_BEHAVIOR,7,109,304,58
    CONTROL         "开机时自动启动(&S)",IDC_SET_AUTOSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,124,288,10
    CONTROL         "关闭窗口时最小化到系统托盘(&T)",IDC_SET_TRAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,142,288,10
END

IDD_SETTINGS_TRANSFER DIALOGEX 0, 0, 318, 232
STYLE DS_SETFONT | WS_CHILD
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    GROUPBOX        "接收文件",IDC_GRP_FILES,7,7,304,82
    LTEXT           "接收文件保存到：",IDC_LBL_DIR,16,24,110,10
    EDITTEXT        IDC_SET_DIR,132,22,96,13,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览(&B)...",IDC_SET_BROWSE,232,22,72,13
    CONTROL         "收到文件时先询问我(&A)",IDC_SET_ASK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,46,288,10
    CONTROL         "接收完成后打开保存文件夹(&O)",IDC_SET_OPENAFTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,64,288,10
    GROUPBOX        "传输保护",IDC_GRP_PROTECT,7,95,304,56
    LTEXT           "接收 PIN 码：",IDC_LBL_PIN,16,112,110,10
    EDITTEXT        IDC_SET_PIN,132,110,60,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "（留空表示不需要 PIN）",IDC_LBL_PIN_HINT,200,112,112,10
END

IDD_SETTINGS_NETWORK DIALOGEX 0, 0, 318, 232
STYLE DS_SETFONT | WS_CHILD
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    GROUPBOX        "端口与公告",IDC_GRP_NET,7,7,304,96
    LTEXT           "监听端口：",IDC_LBL_PORT,16,24,110,10
    EDITTEXT        IDC_SET_PORT,132,22,60,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "公告间隔（秒）：",IDC_LBL_ANNOUNCE,16,46,110,10
    EDITTEXT        IDC_SET_ANNOUNCE,132,44,60,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "本机地址：",IDC_LBL_ADDR,16,70,110,10
    LTEXT           "",IDC_SET_DEVICE_INFO,132,70,172,10
END

IDD_SETTINGS_SECURITY DIALOGEX 0, 0, 318, 232
STYLE DS_SETFONT | WS_CHILD
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    GROUPBOX        "加密传输（HTTPS）",IDC_GRP_TLS,7,7,304,112
    CONTROL         "启用 HTTPS 加密传输(&E)",IDC_SET_HTTPS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,22,288,10
    CONTROL         "允许 TLS 1.0/1.1 回退（兼容旧设备）(&L)",IDC_SET_LEGACY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,38,288,10
    CONTROL         "允许不安全的 HTTPS（不校验证书，不推荐）(&I)",IDC_SET_INSECURE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,54,288,10
    CONTROL         "要求对方提供客户端证书(&R)",IDC_SET_CLIENTCERT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,70,288,10
    LTEXT           "证书指纹：",IDC_LBL_FP,16,90,110,10
    LTEXT           "",IDC_SET_FINGERPRINT,132,88,172,22
    GROUPBOX        "证书文件",IDC_GRP_CERT,7,133,304,78
    LTEXT           "证书文件：",IDC_LBL_CERT,16,150,110,10
    LTEXT           "",IDC_SET_CERT,132,150,172,10
    LTEXT           "CA 证书包：",IDC_LBL_CA,16,170,110,10
    EDITTEXT        IDC_SET_CABUNDLE,132,168,86,13,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览文件(&F)...",IDC_SET_CA_BROWSE,222,168,82,13
END

