#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
// Icon / manifest

IDI_APP             ICON            "..\\icons\\icon.ico"
IDI_SMALL           ICON            "..\\icons\\icon.ico"
IDI_TOOL_SEND_FOLDER ICON           "..\\icons\\send_folder.ico"
IDI_TOOL_FROM_URL   ICON            "..\\icons\\get_from_url.ico"
IDI_TOOL_OPEN_FOLDER ICON           "..\\icons\\get_folder.ico"
IDI_TOOL_SETTINGS   ICON            "..\\icons\\settings.ico"
IDI_TOOL_ABOUT      ICON            "..\\icons\\about.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID  RT_MANIFEST  "LocalSendXP.manifest"

/////////////////////////////////////////////////////////////////////////////
// Menu

IDR_MAINMENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "发送文件(&S)...",                 IDM_FILE_SEND
        MENUITEM "发送文件夹(&D)...",               IDM_FILE_SENDFOLDER
        MENUITEM "通过浏览器分享(&B)...",            IDM_FILE_SHARE
        MENUITEM "从网址接收(&U)...",               IDM_FILE_FROMURL
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                        IDM_FILE_EXIT
    END
    POPUP "设备(&D)"
    BEGIN
        MENUITEM "刷新设备列表(&R)\tF5",            IDM_DEVICE_REFRESH
        MENUITEM "向选中设备发送(&S)",               IDM_DEVICE_SEND
        MENUITEM SEPARATOR
        MENUITEM "打开接收文件夹(&O)",               IDM_DEVICE_OPENFOLDER
    END
    POPUP "工具(&T)"
    BEGIN
        MENUITEM "设置(&O)...",                     IDM_TOOLS_SETTINGS
        MENUITEM "最小化到系统托盘(&M)",             IDM_TOOLS_TRAY
        MENUITEM SEPARATOR
        MENUITEM "开机时自动启动(&A)",               IDM_TOOLS_AUTOSTART
        MENUITEM "查看日志文件(&L)",                 IDM_TOOLS_LOG
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "使用说明(&R)\tF1",                 IDM_HELP_GUIDE
        MENUITEM "LocalSend 协议(&P)",               IDM_HELP_PROTOCOL
        MENUITEM SEPARATOR
        MENUITEM "关于 LocalSend XP(&A)...",         IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Accelerator

IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_F5,          IDM_DEVICE_REFRESH,     VIRTKEY
    VK_F1,          IDM_HELP_GUIDE,         VIRTKEY
    "S",            IDM_FILE_SEND,          VIRTKEY, CONTROL
    "U",            IDM_FILE_FROMURL,       VIRTKEY, CONTROL
    "O",            IDM_TOOLS_SETTINGS,     VIRTKEY, CONTROL
    VK_ESCAPE,      IDM_TOOLS_TRAY,         VIRTKEY
END

/////////////////////////////////////////////////////////////////////////////
// About

IDD_ABOUT DIALOGEX 0, 0, 340, 190
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 LocalSend XP"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    ICON            IDI_APP,IDC_STATIC,14,14,21,20
    LTEXT           "LocalSend XP 1.0.0",IDC_STATIC,60,13,266,10,SS_NOPREFIX
    LTEXT           "非官方 LocalSend 协议客户端",IDC_STATIC,60,26,266,10
    LTEXT           "LocalSend XP 是 LocalSend 协议的非官方 Windows 客户端，面向 Windows XP SP3 及更高版本。",IDC_STATIC,60,46,266,26,SS_NOPREFIX
    LTEXT           "支持的协议版本：LocalSend Protocol v2.2（同时兼容 v1）",IDC_STATIC,60,75,266,20
    LTEXT           "本项目与 LocalSend 官方项目无关。协议参考：github.com/localsend/protocol",IDC_STATIC,60,96,266,26
    LTEXT           "作者：GitHub @daisukiKaffuChino",IDC_ABOUT_AUTHOR,60,124,266,10
    PUSHBUTTON      "开源仓库(&G)",IDC_ABOUT_SOURCE,208,169,62,14
    DEFPUSHBUTTON   "确定",IDOK,276,169,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Built-in help

IDD_HELP DIALOGEX 0, 0, 360, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "使用说明"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    EDITTEXT        IDC_HELP_TEXT,8,8,344,216,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "关闭",IDCANCEL,302,231,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Settings

IDD_SETTINGS DIALOGEX 0, 0, 291, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "设置"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "设备名称：",IDC_STATIC,7,12,50,10
    EDITTEXT        IDC_SET_ALIAS,60,10,130,13,ES_AUTOHSCROLL
    LTEXT           "本机类型：",IDC_STATIC,7,30,50,10
    COMBOBOX        IDC_SET_TYPE,60,28,130,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "设备型号：",IDC_STATIC,7,48,50,10
    EDITTEXT        IDC_SET_MODEL,60,46,130,13,ES_AUTOHSCROLL
    LTEXT           "监听端口：",IDC_STATIC,7,66,50,10
    EDITTEXT        IDC_SET_PORT,60,64,60,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "接收 PIN 码：",IDC_STATIC,7,84,50,10
    EDITTEXT        IDC_SET_PIN,60,82,60,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(留空表示不需要 PIN)",IDC_STATIC,126,84,120,10
    LTEXT           "接收文件保存到：",IDC_STATIC,7,102,50,10
    EDITTEXT        IDC_SET_DIR,60,100,174,13,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览(&B)...",IDC_SET_BROWSE,239,100,45,13
    CONTROL         "收到文件时先询问我(&A)",IDC_SET_ASK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,60,122,200,10
    CONTROL         "接收完成后打开保存文件夹(&O)",IDC_SET_OPENAFTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,60,136,200,10
    CONTROL         "关闭窗口时最小化到系统托盘(&T)",IDC_SET_TRAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,60,150,200,10
    CONTROL         "开机时自动启动(&S)",IDC_SET_AUTOSTART,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,60,164,200,10
    LTEXT           "设置的改变会立即生效；端口修改后需要重新启动程序。",IDC_STATIC,7,186,277,10
    DEFPUSHBUTTON   "确定",IDOK,179,202,50,14
    PUSHBUTTON      "取消",IDCANCEL,234,202,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Incoming transfer confirmation

IDD_RECEIVE DIALOGEX 0, 0, 306, 252
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "接收文件"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "",IDC_RECEIVE_INFO,8,8,290,20
    CONTROL         "",IDC_RECEIVE_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,8,30,290,186
    DEFPUSHBUTTON   "接受(&A)",IDOK,193,230,50,14
    PUSHBUTTON      "拒绝(&D)",IDCANCEL,248,230,50,14
END

/////////////////////////////////////////////////////////////////////////////
// PIN prompt

IDD_PIN DIALOGEX 0, 0, 224, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "输入 PIN 码"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "接收方要求输入 PIN 码，请输入 6 位数字：",IDC_STATIC,8,10,208,18
    EDITTEXT        IDC_PIN_EDIT,8,34,208,13,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "确定",IDOK,112,68,50,14
    PUSHBUTTON      "取消",IDCANCEL,167,68,50,14
END

/////////////////////////////////////////////////////////////////////////////
// Browser share

IDD_URL DIALOGEX 0, 0, 268, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "从网址接收"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "请输入对方分享的网址：",IDC_STATIC,8,10,252,10
    EDITTEXT        IDC_URL_EDIT,8,26,252,13,ES_AUTOHSCROLL
    LTEXT           "例如：http://192.168.1.5:53317",IDC_STATIC,8,44,252,10
    DEFPUSHBUTTON   "确定",IDOK,156,76,50,14
    PUSHBUTTON      "取消",IDCANCEL,210,76,50,14
END


IDD_SHARE DIALOGEX 0, 0, 320, 110
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "通过浏览器分享"
FONT 9, "宋体", 400, 0, 0x86
BEGIN
    LTEXT           "在接收方的浏览器中打开下面的网址即可下载文件：",IDC_STATIC,8,10,304,10
    EDITTEXT        IDC_SHARE_URL,8,26,304,13,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "复制(&C)",IDC_SHARE_COPY,200,66,55,14
    DEFPUSHBUTTON   "关闭",IDCANCEL,257,66,55,14
END

